{
  "name": "code-review-action",
  "version": "0.0.0",
  "private": true,
  "description": "GitHub Action that reviews pull requests with OpenCode or Pi",
  "license": "MIT",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node24 --format=cjs --minify-whitespace --legal-comments=none --outfile=dist/index.js && node scripts/normalize-bundle.mjs",
    "test": "tsx --test test/*.test.ts",
    "test:integration": "RUN_LLM_INTEGRATION=1 tsx --test test/integration.test.ts",
    "test:indexers": "RUN_INDEXER_INTEGRATION=1 tsx --test test/indexer-integration.test.ts",
    "test:models": "RUN_MODEL_CONTRACT=1 tsx --test test/model-contract.test.ts",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/ms": "2.1.0",
    "@types/node": "20.19.43",
    "esbuild": "0.28.2",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@actions/cache": "6.2.0",
    "ms": "2.1.3"
  }
}
